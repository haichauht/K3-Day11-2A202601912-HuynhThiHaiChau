# Sao chép file này thành .env rồi điền giá trị thật.
# Không commit file .env lên GitHub.

# OpenAI API key — lấy tại https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here

# Model dùng chung; có thể override bằng OPENAI_JUDGE_MODEL / OPENAI_RED_TEAM_MODEL
OPENAI_MODEL=gpt-5.6

# Mã sinh viên dùng khi sinh outputs/*.json
STUDENT_ID=2A202601912
